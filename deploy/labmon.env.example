# /etc/labmon/labmon.env — owner root:labmon, mode 0640. Secrets live only here.
LABMON_ENV=production
LABMON_DATABASE_URL=postgresql+psycopg://labmon_app:CHANGE_ME@127.0.0.1:5432/labmon
LABMON_STATIC_DIR=/opt/labmon/current/web
LABMON_EXPORT_DIR=/var/lib/labmon/exports
LABMON_BACKUP_STATUS_FILE=/var/lib/labmon/backups/backup-status.json
LABMON_DISPLAY_TZ=Asia/Kolkata
LABMON_COOKIE_SECURE=true
LABMON_SESSION_TTL_HOURS=12

[Unit]
Description=Lab Instrument Monitor API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=labmon
Group=labmon
EnvironmentFile=/etc/labmon/labmon.env
WorkingDirectory=/var/lib/labmon
ExecStart=/opt/labmon/current/venv/bin/labmon-server serve --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
# hardening: the API never needs to write outside its state directories
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/labmon
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
